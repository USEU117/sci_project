diff --git a/eval_WinCLIP_matrix.py b/eval_WinCLIP_matrix.py
new file mode 100644
--- /dev/null
+++ b/eval_WinCLIP_matrix.py
@@ -0,0 +1,138 @@
+import json
+import os
+
+import numpy as np
+import torch
+
+from eval_WinCLIP import get_args, test
+from datasets import dataset_classes, get_dataloader_from_args
+from utils.csv_utils import save_metric
+from utils.training_utils import get_dir_from_args, logger, setup_seed
+from WinCLIP import WinClipAD
+
+
+def prediction_dir(kwargs):
+    return os.path.join(
+        kwargs["root_dir"],
+        f"{kwargs['dataset']}-k-{kwargs['k_shot']}",
+        f"seed-{kwargs['experiment_indx']}",
+        "predictions",
+    )
+
+
+def output_complete(kwargs, category):
+    output_dir = prediction_dir(kwargs)
+    return (
+        os.path.isfile(os.path.join(output_dir, category + ".npz"))
+        and os.path.isfile(os.path.join(output_dir, category + "_selection.json"))
+    )
+
+
+def evaluate_category(model, device, kwargs, category):
+    kwargs["class_name"] = category
+    setup_seed(kwargs["seed"])
+
+    _, img_dir, _, _, csv_path = get_dir_from_args(**kwargs)
+    if kwargs["k_shot"] > 0:
+        train_dataloader, train_dataset_inst = get_dataloader_from_args(
+            phase="train", perturbed=False, **kwargs
+        )
+    else:
+        train_dataloader, train_dataset_inst = None, None
+    test_dataloader, _ = get_dataloader_from_args(
+        phase="test", perturbed=False, **kwargs
+    )
+
+    feature_cache_path = (
+        os.path.join(kwargs["feature_cache_dir"], category + ".pt")
+        if kwargs["feature_cache_dir"]
+        else None
+    )
+    metrics, score_maps, image_labels, gt_masks, sample_ids = test(
+        model,
+        test_dataloader,
+        device,
+        is_vis=kwargs["vis"],
+        img_dir=img_dir,
+        class_name=category,
+        cal_pro=kwargs["cal_pro"],
+        train_data=train_dataloader,
+        resolution=kwargs["resolution"],
+        feature_cache_path=feature_cache_path,
+    )
+
+    output_dir = prediction_dir(kwargs)
+    os.makedirs(output_dir, exist_ok=True)
+    np.savez_compressed(
+        os.path.join(output_dir, category + ".npz"),
+        gt_sp=image_labels,
+        pr_sp=score_maps.reshape(len(score_maps), -1).max(axis=1),
+        imgs_masks=gt_masks,
+        anomaly_maps=score_maps,
+        sample_ids=np.asarray(sample_ids),
+    )
+    with open(
+        os.path.join(output_dir, category + "_selection.json"),
+        "w",
+        encoding="utf-8",
+    ) as stream:
+        json.dump(
+            {
+                "category": category,
+                "shot": kwargs["k_shot"],
+                "seed_index": kwargs["experiment_indx"],
+                "manifest": os.environ.get("WINCLIP_UNIFIED_MANIFEST"),
+                "selected_reference_images": (
+                    list(train_dataset_inst.img_paths)
+                    if train_dataset_inst is not None
+                    else []
+                ),
+            },
+            stream,
+            ensure_ascii=False,
+            indent=2,
+        )
+
+    for key, value in metrics.items():
+        logger.info(f"{category}======={key}: {value:.2f}")
+    save_metric(
+        metrics,
+        list(dataset_classes[kwargs["dataset"]]),
+        category,
+        kwargs["dataset"],
+        csv_path,
+    )
+
+
+def main(args):
+    kwargs = vars(args)
+    seed_values = [111, 333, 999]
+    kwargs["seed"] = seed_values[kwargs["experiment_indx"]]
+    kwargs["device"] = "cpu" if kwargs["use_cpu"] else "cuda:0"
+    kwargs["out_size_h"] = kwargs["resolution"]
+    kwargs["out_size_w"] = kwargs["resolution"]
+
+    categories = list(dataset_classes[kwargs["dataset"]])
+    missing = [
+        category
+        for category in categories
+        if not output_complete(kwargs, category)
+    ]
+    if not missing:
+        print("All category prediction files already exist.")
+        return
+
+    setup_seed(kwargs["seed"])
+    model = WinClipAD(**kwargs).to(kwargs["device"])
+    for category in missing:
+        print(f"MATRIX_CATEGORY_START {category}", flush=True)
+        evaluate_category(model, kwargs["device"], kwargs, category)
+        print(f"MATRIX_CATEGORY_DONE {category}", flush=True)
+
+
+if __name__ == "__main__":
+    parsed_args = get_args()
+    os.environ["CURL_CA_BUNDLE"] = ""
+    os.environ["CUDA_VISIBLE_DEVICES"] = str(parsed_args.gpu_id)
+    main(parsed_args)
+
